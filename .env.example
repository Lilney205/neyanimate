# Database configuration
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ney_animate?schema=public"

# Application public canonical URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Initial administrator bootstrap (used with: npm run auth:bootstrap-admin)
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_NAME=""
BOOTSTRAP_ADMIN_PASSWORD=""

# NEY Media Core (server-side only; public HTTPS origin in production)
# Local development: http://localhost:8080
NEY_MEDIA_CORE_URL=""
# Never use NEXT_PUBLIC_ variables for the permanent service key.
NEY_MEDIA_CORE_SERVICE_KEY=""

# Shared persistent rate limiter (optional; defaults to PostgreSQL RateLimit table)
REDIS_URL=""

# Reverse proxy trust configuration (set to "true" when behind a trusted proxy)
TRUST_PROXY="false"
TRUSTED_PROXIES=""

# Email delivery configuration for account recovery (optional in development; required in production)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM=""
SMTP_SECURE="false"
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES="15"

# Social sign-in OAuth credentials. Register the matching callback URLs in each provider console.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# Phone sign-in with Twilio Verify
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""
